# Copie este arquivo para .env e ajuste os valores locais quando os serviços forem configurados.
POSTGRES_DB=triagem_chamados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/triagem_chamados
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# Ativar somente na primeira adoção de banco legado, conforme README.
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
IA_API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8080
EVOLUTION_ENABLED=false
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Segredo independente da api-key, com pelo menos 32 caracteres.
EVOLUTION_WEBHOOK_TOKEN=
EVOLUTION_CONNECT_TIMEOUT=3s
EVOLUTION_READ_TIMEOUT=8s
EVOLUTION_MANAGED=false
# No Compose, definidos automaticamente com os enderecos internos dos servicos.
EVOLUTION_WEBHOOK_URL=

# Primeiro administrador: preencher localmente; remover após criar a conta.
TRIAGEM_ADMIN_LOGIN=
TRIAGEM_ADMIN_PASSWORD=
